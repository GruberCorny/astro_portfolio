---
import { Image, Picture } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/about.css";

import profileImage from "../../assets/profile.jpg";
import sproutIcon from "../../assets/icons/sprout.svg";
import brainIcon from "../../assets/icons/brain-circuit.svg";
import stoneIcon from "../../assets/icons/stone.svg";
import shieldIcon from "../../assets/icons/shield-check.svg";
import htmlIcon from "../../assets/logos/html-5-no-wordmark-svgrepo-com.svg";
import cssIcon from "../../assets/logos/css-3-svgrepo-com.svg";
import jsIcon from "../../assets/logos/js-svgrepo-com.svg";
import tsIcon from "../../assets/logos/typescript-icon-svgrepo-com.svg";
import astroIcon from "../../assets/logos/astro-original.svg";
import cIcon from "../../assets/logos/c-svgrepo-com.svg";
import javaIcon from "../../assets/logos/java-svgrepo-com.svg";
import kotlinIcon from "../../assets/logos/Kotlin_icon_(2021-present).svg";
import pythonIcon from "../../assets/logos/python-svgrepo-com.svg";
import sqlIcon from "../../assets/logos/sql-database-generic-svgrepo-com.svg";
import asmIcon from "../../assets/logos/asm-icon.svg";
import arduinoIcon from "../../assets/logos/arduino-svgrepo-com.svg";
import fritzingIcon from "../../assets/logos/fritzing.svg";
import atmelIcon from "../../assets/logos/AtmelStudio-Logos/AtmelStudio-Bug-White-With-BG.svg";
import githubIcon from "../../assets/logos/github-icon-svgrepo-com.svg";
import gitIcon from "../../assets/logos/git-icon-svgrepo-com.svg";
import vscodeIcon from "../../assets/logos/vs-code-svgrepo-com.svg";
import linuxIcon from "../../assets/logos/linux-svgrepo-com.svg";
import bashIcon from "../../assets/logos/bash-icon-svgrepo-com.svg";
import dockerIcon from "../../assets/logos/docker-svgrepo-com.svg";
import figmaIcon from "../../assets/logos/figma-svgrepo-com.svg";
import godotIcon from "../../assets/logos/godot-original.svg";
import leafIcon from "../../assets/logos/leaf.svg";
import guitarIcon from "../../assets/logos/guitar.svg";
import gamepadIcon from "../../assets/logos/gamepad-2.svg";
import bookTextIcon from "../../assets/logos/book-text.svg";
import settingsIcon from "../../assets/logos/settings.svg";
---

<BaseLayout title="About Me – Corny Gruber">
    <!-- Wer bin ich -->
    <section class="about-hero">
        <Picture
            loading="eager"
            src={profileImage}
            alt="Corny Gruber"
            class="about-photo"
            width={240}
            height={240}
            widths={[240, 480]}
            sizes="(max-width: 720px) 140px, 240px"
            formats={["avif", "webp", "jpeg"]}
            quality={86}
        />
        <div class="about-intro">
            <p class="section-label">Wer bin ich</p>
            <h1>Corny Gruber</h1>
            <p>
                Aufgewachsen auf einem Bauernhof, hab ich früh gelernt, dass
                gute Arbeit Geduld, Sorgfalt und ein ehrliches Interesse an der
                Sache braucht. Dieses Denken nehme ich in jeden Code, den ich
                schreibe.
            </p>
            <p>
                Ich entwickle Web-Applikationen, Embedded-Systeme und alles, was
                mich intellektuell fordert – ohne Bullshit, ohne übertriebenes
                Selbstmarketing.
            </p>
        </div>
    </section>

    <!-- Wie bin ich -->
    <section class="personality-section">
        <p class="section-label">Wie bin ich</p>
        <h2>Persönlichkeit & Werte</h2>
        <div class="traits-grid">
            <div class="trait-card">
                <div class="trait-icon">
                    <Image
                        loading="eager"
                        src={sproutIcon}
                        alt="Sprout"
                        width={30}
                        height={30}
                        quality={100}
                    />
                </div>
                <h3>Bodenständig</h3>
                <p>
                    Kein Hype, kein Overengineering. Ich baue, was gebraucht
                    wird – solide und wartbar.
                </p>
            </div>
            <div class="trait-card">
                <div class="trait-icon">
                    <Image
                        loading="eager"
                        src={brainIcon}
                        alt="Brain"
                        width={30}
                        height={30}
                        quality={100}
                    />
                </div>
                <h3>Neugierig</h3>
                <p>
                    Von Assembly bis Pflanzenkunde: Wenn mich etwas
                    interessiert, tauch ich tief ein.
                </p>
            </div>
            <div class="trait-card">
                <div class="trait-icon">
                    <Image
                        loading="eager"
                        src={stoneIcon}
                        alt="Stone"
                        width={30}
                        height={30}
                        quality={100}
                    />
                </div>
                <h3>Ruhig & Gelassen</h3>
                <p>
                    Stress löst keine Probleme. Ich denke erst nach, bevor ich
                    handle.
                </p>
            </div>
            <div class="trait-card">
                <div class="trait-icon">
                    <Image
                        loading="eager"
                        src={shieldIcon}
                        alt="Shield"
                        width={30}
                        height={30}
                        quality={100}
                    />
                </div>
                <h3>Ehrlich</h3>
                <p>
                    „What you see is what you get.“ Ich sage, was ich denke –
                    respektvoll und direkt.
                </p>
            </div>
        </div>
    </section>

    <!-- Was kann ich -->
    <section class="skills-section">
        <p class="section-label">Was kann ich</p>
        <h2>Hard Skills & Werkzeuge</h2>
        <div class="skills-columns">
            <div class="skills-group">
                <h3>Frontend</h3>
                <ul class="skill-list">
                    <li class="skill-item">
                        <span>HTML</span>
                        <div class="skill-logos">
                            <Image
                                loading="eager"
                                src={htmlIcon}
                                alt="HTML5"
                                width={22}
                                height={22}
                                quality={100}
                            />
                        </div>
                    </li>
                    <li class="skill-item">
                        <span>CSS</span>
                        <div class="skill-logos">
                            <Image
                                loading="eager"
                                src={cssIcon}
                                alt="CSS3"
                                width={22}
                                height={22}
                                quality={100}
                            />
                        </div>
                    </li>
                    <li class="skill-item">
                        <span>JavaScript</span>
                        <div class="skill-logos">
                            <Image
                                loading="eager"
                                src={jsIcon}
                                alt="JavaScript"
                                width={22}
                                height={22}
                                quality={100}
                            />
                        </div>
                    </li>
                    <li class="skill-item">
                        <span>TypeScript</span>
                        <div class="skill-logos">
                            <Image
                                src={tsIcon}
                                alt="TypeScript"
                                width={22}
                                height={22}
                                quality={100}
                            />
                        </div>
                    </li>
                    <li class="skill-item">
                        <span>Astro</span>
                        <div class="skill-logos">
                            <Image
                                src={astroIcon}
                                alt="Astro"
                                width={22}
                                height={22}
                                quality={100}
                                class="logo-dark"
                            />
                        </div>
                    </li>
                </ul>
            </div>

            <div class="skills-group">
                <h3>Backend & Systems</h3>
                <ul class="skill-list">
                    <li class="skill-item">
                        <span>C</span>
                        <div class="skill-logos">
                            <Image
                                loading="eager"
                                src={cIcon}
                                alt="C"
                                width={22}
                                height={22}
                                quality={100}
                            />
                        </div>
                    </li>
                    <li class="skill-item">
                        <span>Java</span>
                        <div class="skill-logos">
                            <Image
                                loading="eager"
                                src={javaIcon}
                                alt="Java"
                                width={22}
                                height={22}
                                quality={100}
                            />
                        </div>
                    </li>
                    <li class="skill-item">
                        <span>Kotlin</span>
                        <div class="skill-logos">
                            <Image
                                loading="eager"
                                src={kotlinIcon}
                                alt="Kotlin"
                                width={22}
                                height={22}
                                quality={100}
                            />
                        </div>
                    </li>
                    <li class="skill-item">
                        <span>Python</span>
                        <div class="skill-logos">
                            <Image
                                src={pythonIcon}
                                alt="Python"
                                width={22}
                                height={22}
                                quality={100}
                            />
                        </div>
                    </li>
                    <li class="skill-item">
                        <span>SQL</span>
                        <div class="skill-logos">
                            <Image
                                src={sqlIcon}
                                alt="SQL"
                                width={22}
                                height={22}
                                quality={100}
                            />
                        </div>
                    </li>
                </ul>
            </div>

            <div class="skills-group">
                <h3>Embedded</h3>
                <ul class="skill-list">
                    <li class="skill-item">
                        <span>Assembly x86</span>
                        <div class="skill-logos">
                            <Image
                                src={asmIcon}
                                alt="Assembly x86"
                                width={22}
                                height={22}
                                quality={100}
                            />
                        </div>
                    </li>
                    <li class="skill-item">
                        <span>Arduino</span>
                        <div class="skill-logos">
                            <Image
                                src={arduinoIcon}
                                alt="Arduino"
                                width={22}
                                height={22}
                                quality={100}
                            />
                        </div>
                    </li>
                    <li class="skill-item">
                        <span>Fritzing</span>
                        <div class="skill-logos">
                            <Image
                                src={fritzingIcon}
                                alt="Fritzing"
                                width={22}
                                height={22}
                                quality={100}
                                class="logo-dark"
                            />
                        </div>
                    </li>
                    <li class="skill-item">
                        <span>Atmel / Microchip Studio</span>
                        <div class="skill-logos">
                            <Image
                                src={atmelIcon}
                                alt="Atmel"
                                width={22}
                                height={22}
                                quality={100}
                                class="logo-dark"
                            />
                        </div>
                    </li>
                </ul>
            </div>

            <div class="skills-group">
                <h3>Tools</h3>
                <ul class="skill-list">
                    <li class="skill-item">
                        <span>Git</span>
                        <div class="skill-logos">
                            <Image
                                src={gitIcon}
                                alt="Git"
                                width={22}
                                height={22}
                                quality={100}
                            />
                        </div>
                    </li>
                    <li class="skill-item">
                        <span>VS Code</span>
                        <div class="skill-logos">
                            <Image
                                src={vscodeIcon}
                                alt="VS Code"
                                width={22}
                                height={22}
                                quality={100}
                            />
                        </div>
                    </li>
                    <li class="skill-item">
                        <span>Bash</span>
                        <div class="skill-logos">
                            <Image
                                src={bashIcon}
                                alt="Bash"
                                width={22}
                                height={22}
                                quality={100}
                            />
                        </div>
                    </li>
                    <li class="skill-item">
                        <span>Docker</span>
                        <div class="skill-logos">
                            <Image
                                src={dockerIcon}
                                alt="Docker"
                                width={22}
                                height={22}
                                quality={100}
                            />
                        </div>
                    </li>
                    <li class="skill-item">
                        <span>Godot Engine</span>
                        <div class="skill-logos">
                            <Image
                                src={godotIcon}
                                alt="Godot"
                                width={22}
                                height={22}
                                quality={100}
                            />
                        </div>
                    </li>
                </ul>
            </div>
        </div>
    </section>

    <!-- Interessen -->
    <section class="interests-section">
        <p class="section-label">Persönliche Interessen</p>
        <h2>Was mich bewegt</h2>
        <div class="interests-grid">
            <span class="interest-tag">
                <div class="hobby-logos">
                    <Image
                        src={leafIcon}
                        alt="Natur"
                        width={22}
                        height={22}
                        quality={100}
                    />
                </div>
                <p>Natur & Landwirtschaft</p>
            </span>
            <span class="interest-tag">
                <div class="hobby-logos">
                    <Image
                        src={guitarIcon}
                        alt="Gitarre"
                        width={22}
                        height={22}
                        quality={100}
                    />
                </div>
                <p>Gitarre</p>
            </span>
            <span class="interest-tag">
                <div class="hobby-logos">
                    <Image
                        src={gamepadIcon}
                        alt="Spiele"
                        width={22}
                        height={22}
                        quality={100}
                    />
                </div>
                <p>Videospiele</p>
            </span>
            <span class="interest-tag">
                <div class="hobby-logos">
                    <Image
                        src={bookTextIcon}
                        alt="Neues Lernen"
                        width={22}
                        height={22}
                        quality={100}
                    />
                </div>
                <p>Lesen</p>
            </span>
            <span class="interest-tag">
                <div class="hobby-logos">
                    <Image
                        src={settingsIcon}
                        alt="Basteln"
                        width={22}
                        height={22}
                        quality={100}
                    />
                </div>
                <p>Basteln & Hardware</p>
            </span>
        </div>
    </section>
</BaseLayout>
