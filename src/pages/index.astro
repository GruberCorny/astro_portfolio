---
import { Image, Picture, type ImageMetadata } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/home.css";
import "../styles/about.css";

import appPreview from "../../assets/App/dobble_App.png";
import bitburnerPreview from "../../assets/bitburner/center_code.png";
import revxtPreview from "../../assets/RevXT/fritz-feature_map_encoding.png";
import profileImage from "../../assets/profile.jpg";
import sproutIcon from "../../assets/icons/sprout.svg";
import brainIcon from "../../assets/icons/brain-circuit.svg";
import stoneIcon from "../../assets/icons/stone.svg";
import shieldIcon from "../../assets/icons/shield-check.svg";
import htmlIcon from "../../assets/logos/html-5-no-wordmark-svgrepo-com.svg";
import cssIcon from "../../assets/logos/CSS-Logo.svg";
import jsIcon from "../../assets/logos/js-svgrepo-com.svg";
import tsIcon from "../../assets/logos/typescript-icon-svgrepo-com.svg";
import astroIcon from "../../assets/logos/astro-original.svg";
import cIcon from "../../assets/logos/c-svgrepo-com.svg";
import javaIcon from "../../assets/logos/java-svgrepo-com.svg";
import kotlinIcon from "../../assets/logos/Kotlin_icon_(2021-present).svg";
import pythonIcon from "../../assets/logos/python-svgrepo-com.svg";
import sqlIcon from "../../assets/logos/sql-database-generic-svgrepo-com.svg";
import asmIcon from "../../assets/logos/asm-icon.svg";
import arduinoIcon from "../../assets/logos/arduino-svgrepo-com.svg";
import fritzingIcon from "../../assets/logos/fritzing.svg";
import atmelIcon from "../../assets/logos/AtmelStudio-Logos/AtmelStudio-Bug-White-With-BG.svg";
import gitIcon from "../../assets/logos/git-icon-svgrepo-com.svg";
import vscodeIcon from "../../assets/logos/vs-code-svgrepo-com.svg";
import bashIcon from "../../assets/logos/bash-icon-svgrepo-com.svg";
import dockerIcon from "../../assets/logos/docker-svgrepo-com.svg";
import godotIcon from "../../assets/logos/godot-original.svg";
import leafIcon from "../../assets/logos/leaf.svg";
import guitarIcon from "../../assets/logos/guitar.svg";
import gamepadIcon from "../../assets/logos/gamepad-2.svg";
import bookTextIcon from "../../assets/logos/book-text.svg";
import settingsIcon from "../../assets/logos/settings.svg";

const projects: Array<{
	category: string;
	title: string;
	description: string;
	image: ImageMetadata;
	alt: string;
	link: string;
}> = [
	{
		category: "Web & App",
		title: "App-Entwicklung",
		description:
			"Von der Idee bis zum nutzbaren Produkt – strukturiert, verständlich und direkt im Einsatz.",
		image: appPreview,
		alt: "App-Entwicklung – Projektvorschau",
		link: "/projects/app-entwicklung",
	},
	{
		category: "Game & Scripting",
		title: "Bitburner",
		description:
			"Automatisierung, Strategie und Programmier-Logik, die direkt im Spiel zu spürbaren Ergebnissen führen.",
		image: bitburnerPreview,
		alt: "Bitburner – Projektvorschau",
		link: "/projects/bitburner",
	},
	{
		category: "System & Forschung",
		title: "RevXT",
		description:
			"Ein technisches Projekt mit klaren Zielen, experimenteller Entwicklung und schnellen Iterationen.",
		image: revxtPreview,
		alt: "RevXT – Projektvorschau",
		link: "/projects/revxt",
	},
];
---

<BaseLayout title="Corny Gruber Portfolio">
	<section class="hero">
		<div class="hero-content">
			<hgroup>
				<p class="h5">Hallo, ich bin</p>
				<h1 class="hero-title">Cornelius Gruber</h1>
			</hgroup>
			<p class="hero-subtitle">
				Ich entwickle gerne an Hardwarenahen Projekten wie <b
					>Embedded-Systemen</b
				> aber habe auch gerne Visuelles Feedback von <b
					>Webanwendungen und Apps</b
				>.
			</p>
			<div class="hero-cta">
				<a href="#about-me" class="btn-primary">Mehr über mich</a>
				<a href="/projects/app-entwicklung" class="btn-secondary"
					>Projekte ansehen</a
				>
			</div>
		</div>
		<div class="hero-visual">
			<Picture
				loading="eager"
				src={profileImage}
				alt="Corny Gruber"
				class="hero-avatar"
				width={220}
				height={220}
				widths={[220, 440]}
				sizes="(max-width: 720px) 160px, 220px"
				formats={["avif", "webp", "jpeg"]}
				quality={80}
			/>
		</div>
		<div class="skills-strip">
			<span class="badge">Embedded Systems</span>
			<span class="badge">C</span>
			<span class="badge">Java</span>
			<span class="badge">Kotlin</span>
			<span class="badge">Assembly x86</span>
			<span class="badge">Godot</span>
		</div>
	</section>

	<section class="project-showcase" aria-label="Projektvorschau">
		<hgroup class="section-heading">
			<p class="eyebrow">Projekte</p>
			<h2>Kurze Einblicke in meine Arbeiten</h2>
		</hgroup>

		<div class="project-showcase-shell">
			<button
				class="project-nav project-prev"
				type="button"
				aria-label="Vorheriges Projekt"
			>
				&#8249;
			</button>

			<div class="project-showcase-stage" id="project-showcase-stage">
				{
					projects.map((project, index) => (
						<article
							class:list={[
								"project-slide",
								index === 0 && "is-active",
							]}
							data-index={index}
							aria-hidden={index === 0 ? "false" : "true"}
						>
							<a href={project.link} class="project-slide-link">
								<Picture
									loading="eager"
									src={project.image}
									alt={project.alt}
									class="project-slide-bg"
									widths={[640, 960, 1280]}
									sizes="(max-width: 720px) 100vw, 1200px"
									formats={["avif", "webp", "jpeg"]}
									quality={72}
								/>
								<div class="project-slide-overlay" />
								<div class="project-slide-content">
									<span class="project-pill">
										{project.category}
									</span>
									<h3>{project.title}</h3>
									<p>{project.description}</p>
									<span class="project-cta">
										Projekt ansehen
									</span>
								</div>
							</a>
						</article>
					))
				}
			</div>

			<button
				class="project-nav project-next"
				type="button"
				aria-label="Nächstes Projekt"
			>
				&#8250;
			</button>
		</div>
	</section>

	<section class="personality-section">
		<h2>Persönlichkeit & Werte</h2>
		<div class="traits-grid">
			<div class="trait-card">
				<div class="trait-icon">
					<Image
						loading="eager"
						src={sproutIcon}
						alt="Sprout"
						width={30}
						height={30}
						quality={100}
					/>
				</div>
				<h3>Bodenständig</h3>
				<p>
					Kein Hype, kein Overengineering. Alles solide und wartbar.
				</p>
			</div>
			<div class="trait-card">
				<div class="trait-icon">
					<Image
						loading="eager"
						src={brainIcon}
						alt="Brain"
						width={30}
						height={30}
						quality={100}
					/>
				</div>
				<h3>Neugierig</h3>
				<p>
					Wenn ich etwas nicht verstehe, finde ich heraus, wie es
					funktioniert.
				</p>
			</div>
			<div class="trait-card">
				<div class="trait-icon">
					<Image
						loading="eager"
						src={stoneIcon}
						alt="Stone"
						width={30}
						height={30}
						quality={100}
					/>
				</div>
				<h3>Ruhig & Gelassen</h3>
				<p>Sorgfältiges Arbeiten spart Zeit und Nerven.</p>
			</div>
			<div class="trait-card">
				<div class="trait-icon">
					<Image
						loading="eager"
						src={shieldIcon}
						alt="Shield"
						width={30}
						height={30}
						quality={100}
					/>
				</div>
				<h3>Ehrlich</h3>
				<p>Eine zuverlässige Antwort, ist mehr wert als viele Worte.</p>
			</div>
		</div>
	</section>

	<section class="skills-section">
		<h2>Hard Skills & Werkzeuge</h2>
		<div class="skills-columns">
			<div class="skills-group">
				<h3>Frontend</h3>
				<ul class="skill-list">
					<li class="skill-item">
						<span>HTML</span>
						<div class="skill-logos">
							<Image
								loading="eager"
								src={htmlIcon}
								alt="HTML5"
								width={22}
								height={22}
								quality={100}
							/>
						</div>
					</li>
					<li class="skill-item">
						<span>CSS</span>
						<div class="skill-logos">
							<Image
								loading="eager"
								src={cssIcon}
								alt="CSS3"
								width={22}
								height={22}
								quality={100}
							/>
						</div>
					</li>
					<li class="skill-item">
						<span>JavaScript</span>
						<div class="skill-logos">
							<Image
								loading="eager"
								src={jsIcon}
								alt="JavaScript"
								width={22}
								height={22}
								quality={100}
							/>
						</div>
					</li>
					<li class="skill-item">
						<span>TypeScript</span>
						<div class="skill-logos">
							<Image
								src={tsIcon}
								alt="TypeScript"
								width={22}
								height={22}
								quality={100}
							/>
						</div>
					</li>
					<li class="skill-item">
						<span>Astro</span>
						<div class="skill-logos">
							<Image
								src={astroIcon}
								alt="Astro"
								width={22}
								height={22}
								quality={100}
								class="logo-dark"
							/>
						</div>
					</li>
				</ul>
			</div>

			<div class="skills-group">
				<h3>Backend & Systems</h3>
				<ul class="skill-list">
					<li class="skill-item">
						<span>C</span><div class="skill-logos">
							<Image
								loading="eager"
								src={cIcon}
								alt="C"
								width={22}
								height={22}
								quality={100}
							/>
						</div>
					</li>
					<li class="skill-item">
						<span>Java</span><div class="skill-logos">
							<Image
								loading="eager"
								src={javaIcon}
								alt="Java"
								width={22}
								height={22}
								quality={100}
							/>
						</div>
					</li>
					<li class="skill-item">
						<span>Kotlin</span><div class="skill-logos">
							<Image
								loading="eager"
								src={kotlinIcon}
								alt="Kotlin"
								width={22}
								height={22}
								quality={100}
							/>
						</div>
					</li>
					<li class="skill-item">
						<span>Python</span><div class="skill-logos">
							<Image
								src={pythonIcon}
								alt="Python"
								width={22}
								height={22}
								quality={100}
							/>
						</div>
					</li>
					<li class="skill-item">
						<span>SQL</span><div class="skill-logos">
							<Image
								src={sqlIcon}
								alt="SQL"
								width={22}
								height={22}
								quality={100}
							/>
						</div>
					</li>
				</ul>
			</div>

			<div class="skills-group">
				<h3>Embedded</h3>
				<ul class="skill-list">
					<li class="skill-item">
						<span>Assembly x86</span><div class="skill-logos">
							<Image
								src={asmIcon}
								alt="Assembly x86"
								width={22}
								height={22}
								quality={100}
							/>
						</div>
					</li>
					<li class="skill-item">
						<span>Arduino</span><div class="skill-logos">
							<Image
								src={arduinoIcon}
								alt="Arduino"
								width={22}
								height={22}
								quality={100}
							/>
						</div>
					</li>
					<li class="skill-item">
						<span>Fritzing</span><div class="skill-logos">
							<Image
								src={fritzingIcon}
								alt="Fritzing"
								width={22}
								height={22}
								quality={100}
								class="logo-dark"
							/>
						</div>
					</li>
					<li class="skill-item">
						<span>Atmel / Microchip Studio</span><div
							class="skill-logos"
						>
							<Image
								src={atmelIcon}
								alt="Atmel"
								width={22}
								height={22}
								quality={100}
								class="logo-dark"
							/>
						</div>
					</li>
				</ul>
			</div>

			<div class="skills-group">
				<h3>Tools</h3>
				<ul class="skill-list">
					<li class="skill-item">
						<span>Git</span><div class="skill-logos">
							<Image
								src={gitIcon}
								alt="Git"
								width={22}
								height={22}
								quality={100}
							/>
						</div>
					</li>
					<li class="skill-item">
						<span>VS Code</span><div class="skill-logos">
							<Image
								src={vscodeIcon}
								alt="VS Code"
								width={22}
								height={22}
								quality={100}
							/>
						</div>
					</li>
					<li class="skill-item">
						<span>Bash</span><div class="skill-logos">
							<Image
								src={bashIcon}
								alt="Bash"
								width={22}
								height={22}
								quality={100}
							/>
						</div>
					</li>
					<li class="skill-item">
						<span>Docker</span><div class="skill-logos">
							<Image
								src={dockerIcon}
								alt="Docker"
								width={22}
								height={22}
								quality={100}
							/>
						</div>
					</li>
					<li class="skill-item">
						<span>Godot Engine</span><div class="skill-logos">
							<Image
								src={godotIcon}
								alt="Godot"
								width={22}
								height={22}
								quality={100}
							/>
						</div>
					</li>
				</ul>
			</div>
		</div>
	</section>

	<section class="interests-section">
		<h2>Was mich bewegt</h2>
		<div class="interests-grid">
			<span class="interest-tag"
				><div class="hobby-logos">
					<Image
						src={leafIcon}
						alt="Natur"
						width={22}
						height={22}
						quality={100}
					/>
				</div><p>Natur & Landwirtschaft</p></span
			>
			<span class="interest-tag"
				><div class="hobby-logos">
					<Image
						src={guitarIcon}
						alt="Gitarre"
						width={22}
						height={22}
						quality={100}
					/>
				</div><p>Gitarre</p></span
			>
			<span class="interest-tag"
				><div class="hobby-logos">
					<Image
						src={gamepadIcon}
						alt="Spiele"
						width={22}
						height={22}
						quality={100}
					/>
				</div><p>Videospiele</p></span
			>
			<span class="interest-tag"
				><div class="hobby-logos">
					<Image
						src={bookTextIcon}
						alt="Neues Lernen"
						width={22}
						height={22}
						quality={100}
					/>
				</div><p>Lesen</p></span
			>
			<span class="interest-tag"
				><div class="hobby-logos">
					<Image
						src={settingsIcon}
						alt="Basteln"
						width={22}
						height={22}
						quality={100}
					/>
				</div><p>Basteln & Hardware</p></span
			>
		</div>
	</section>
</BaseLayout>

<script>
	const slides = Array.from(document.querySelectorAll(".project-slide"));
	const prevButton = document.querySelector(".project-prev");
	const nextButton = document.querySelector(".project-next");
	let activeIndex = 0;

	function updateSlider(newIndex: number) {
		activeIndex = (newIndex + slides.length) % slides.length;

		slides.forEach((slide, index) => {
			const isActive = index === activeIndex;
			slide.classList.toggle("is-active", isActive);
			slide.setAttribute("aria-hidden", String(!isActive));
		});
	}

	prevButton?.addEventListener("click", () => updateSlider(activeIndex - 1));
	nextButton?.addEventListener("click", () => updateSlider(activeIndex + 1));
</script>
