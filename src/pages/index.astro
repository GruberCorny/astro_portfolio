---
import { Image, Picture, type ImageMetadata } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/home.css";
import "../styles/about.css";

import appPreview from "../../assets/App/dobble_App.png";
import bitburnerPreview from "../../assets/bitburner/center_code.png";
import revxtPreview from "../../assets/RevXT/fritz-feature_map_encoding.png";
import embeddedPreview from "../../assets/EM/emkasten.jpg";
import profileImage from "../../assets/profile.jpg";
import sproutIcon from "../../assets/icons/sprout.svg";
import brainIcon from "../../assets/icons/brain-circuit.svg";
import stoneIcon from "../../assets/icons/stone.svg";
import shieldIcon from "../../assets/icons/shield-check.svg";
import htmlIcon from "../../assets/logos/html-5-no-wordmark-svgrepo-com.svg";
import cssIcon from "../../assets/logos/CSS-Logo.svg";
import jsIcon from "../../assets/logos/js-svgrepo-com.svg";
import tsIcon from "../../assets/logos/typescript-icon-svgrepo-com.svg";
import astroIcon from "../../assets/logos/astro-original.svg";
import cIcon from "../../assets/logos/c-svgrepo-com.svg";
import javaIcon from "../../assets/logos/java-svgrepo-com.svg";
import kotlinIcon from "../../assets/logos/Kotlin_icon_(2021-present).svg";
import pythonIcon from "../../assets/logos/python-svgrepo-com.svg";
import sqlIcon from "../../assets/logos/sql-database-generic-svgrepo-com.svg";
import asmIcon from "../../assets/logos/asm-icon.svg";
import arduinoIcon from "../../assets/logos/arduino-svgrepo-com.svg";
import fritzingIcon from "../../assets/logos/fritzing.svg";
import atmelIcon from "../../assets/logos/AtmelStudio-Logos/AtmelStudio-Bug-White-With-BG.svg";
import gitIcon from "../../assets/logos/git-icon-svgrepo-com.svg";
import vscodeIcon from "../../assets/logos/vs-code-svgrepo-com.svg";
import bashIcon from "../../assets/logos/bash-icon-svgrepo-com.svg";
import dockerIcon from "../../assets/logos/docker-svgrepo-com.svg";
import godotIcon from "../../assets/logos/godot-original.svg";
import leafIcon from "../../assets/logos/leaf.svg";
import guitarIcon from "../../assets/logos/guitar.svg";
import gamepadIcon from "../../assets/logos/gamepad-2.svg";
import bookTextIcon from "../../assets/logos/book-text.svg";
import settingsIcon from "../../assets/logos/settings.svg";

const projects: Array<{
	category: string;
	title: string;
	description: string;
	image: ImageMetadata;
	alt: string;
	link: string;
}> = [
	{
		category: "System & Künstliche Intelligenz",
		title: "ReversiXT",
		description:
			"Ein technisches Projekt mit klaren Zielen, experimenteller Entwicklung und schnellen Iterationen.",
		image: revxtPreview,
		alt: "RevXT – Projektvorschau",
		link: "/projects/revxt",
	},
	{
		category: "Web & App",
		title: "App-Entwicklung",
		description:
			"Von der Idee bis zum nutzbaren Produkt – strukturiert, verständlich und direkt im Einsatz.",
		image: appPreview,
		alt: "App-Entwicklung – Projektvorschau",
		link: "/projects/app-entwicklung",
	},
	{
		category: "Embedded Systems",
		title: "Embedded Systems",
		description:
			"Praktische Hardware-nahe Umsetzungen mit Microcontrollern, Sensorik und robuster Steuerlogik.",
		image: embeddedPreview,
		alt: "Embedded Systems – Projektvorschau",
		link: "/projects/embedded-systems",
	},
	{
		category: "Game & Scripting",
		title: "Bitburner",
		description:
			"Automatisierung, Strategie und Programmier-Logik, die direkt im Spiel zu spürbaren Ergebnissen führen.",
		image: bitburnerPreview,
		alt: "Bitburner – Projektvorschau",
		link: "/projects/bitburner",
	},
];
---

<BaseLayout title="Corny Gruber Portfolio">
	<section class="hero">
		<div class="hero-content">
			<hgroup>
				<p class="h5">Hallo, ich bin</p>
				<h1 class="hero-title">Cornelius Gruber</h1>
			</hgroup>
			<p class="hero-subtitle">
				Ich entwickle gerne an hardwarenahen Projekten wie <b
					>Embedded-Systemen</b
				> aber habe auch gerne visuelles Feedback von <b
					>Webanwendungen und Apps</b
				>.
			</p>
			<div class="skills-strip">
				<span class="badge">Embedded Systems</span>
				<span class="badge">C</span>
				<span class="badge">Java</span>
				<span class="badge">Kotlin</span>
				<span class="badge">Assembly x86</span>
			</div>
		</div>
		<div class="hero-visual">
			<Picture
				loading="eager"
				src={profileImage}
				alt="Corny Gruber"
				class="hero-avatar"
				widths={[220, 440, 600]}
				formats={["avif", "webp", "jpeg"]}
				quality={80}
			/>
		</div>
	</section>

	<section class="project-showcase" aria-label="Projektvorschau">
		<hgroup class="section-heading">
			<h2>Kurze Einblicke in meine Arbeiten</h2>
		</hgroup>

		<div class="project-showcase-shell">
			<button
				class="project-nav project-prev"
				type="button"
				aria-label="Vorheriges Projekt"
			>
				&#8249;
			</button>

			<div class="project-showcase-stage" id="project-showcase-stage">
				{
					projects.map((project, index) => (
						<article
							class:list={[
								"project-slide",
								index === 0 && "is-active",
							]}
							data-index={index}
							aria-hidden={index === 0 ? "false" : "true"}
						>
							<a href={project.link} class="project-slide-link">
								<Picture
									loading="eager"
									src={project.image}
									alt={project.alt}
									class="project-slide-bg"
									widths={[640, 960, 1280]}
									sizes="(max-width: 720px) 100vw, 1200px"
									formats={["avif", "webp", "jpeg"]}
									quality={72}
								/>
								<div class="project-slide-overlay" />
								<div class="project-slide-content">
									<span class="project-pill">
										{project.category}
									</span>
									<h3>{project.title}</h3>
									<p>{project.description}</p>
									<span class="project-cta">
										Projekt ansehen
									</span>
								</div>
							</a>
						</article>
					))
				}
			</div>

			<button
				class="project-nav project-next"
				type="button"
				aria-label="Nächstes Projekt"
			>
				&#8250;
			</button>
		</div>
	</section>

	<section class="skills-section">
		<h2>Hard Skills & Werkzeuge</h2>
		<div class="skills-top">
			<h3 class="h6">Lieblings Tools</h3>
			<ul class="favorite-tools">
				<li class="favorite-tools-item">
					<Image
						src={cIcon}
						alt="C"
						width={64}
						height={64}
						quality={100}
						style="scale: 0.9;"
					/>
					<p>C</p>
				</li>
				<li class="favorite-tools-item">
					<Image
						src={javaIcon}
						alt="Java"
						width={64}
						height={64}
						quality={100}
						style="scale: 0.95;"
					/>
					<p>Java</p>
				</li>
				<li class="favorite-tools-item">
					<Image
						src={asmIcon}
						alt="Assembly"
						width={64}
						height={64}
						quality={100}
					/>
					<p>Assembly</p>
				</li>
				<li class="favorite-tools-item">
					<Image
						src={vscodeIcon}
						alt="VS Code"
						width={64}
						height={64}
						quality={100}
					/>
					<p>VS Code</p>
				</li>
			</ul>
		</div>
		<div class="skills-columns">
			<div class="skills-group">
				<h3 class="p">Frontend</h3>
				<ul class="skill-list">
					<li class="skill-item">
						<span>HTML</span>
						<div class="skill-logos">
							<Image
								loading="eager"
								src={htmlIcon}
								alt="HTML5"
								width={22}
								height={22}
								quality={100}
							/>
						</div>
					</li>
					<li class="skill-item">
						<span>CSS</span>
						<div class="skill-logos">
							<Image
								loading="eager"
								src={cssIcon}
								alt="CSS3"
								width={22}
								height={22}
								quality={100}
							/>
						</div>
					</li>
					<li class="skill-item">
						<span>JavaScript</span>
						<div class="skill-logos">
							<Image
								loading="eager"
								src={jsIcon}
								alt="JavaScript"
								width={22}
								height={22}
								quality={100}
							/>
						</div>
					</li>
				</ul>
			</div>

			<div class="skills-group">
				<h3 class="p">Backend & Systems</h3>
				<ul class="skill-list">
					<li class="skill-item">
						<span>Kotlin</span><div class="skill-logos">
							<Image
								loading="eager"
								src={kotlinIcon}
								alt="Kotlin"
								width={22}
								height={22}
								quality={100}
							/>
						</div>
					</li>
					<li class="skill-item">
						<span>Python</span><div class="skill-logos">
							<Image
								src={pythonIcon}
								alt="Python"
								width={22}
								height={22}
								quality={100}
							/>
						</div>
					</li>
					<li class="skill-item">
						<span>SQL</span><div class="skill-logos">
							<Image
								src={sqlIcon}
								alt="SQL"
								width={22}
								height={22}
								quality={100}
							/>
						</div>
					</li>
				</ul>
			</div>

			<div class="skills-group">
				<h3 class="p">Embedded</h3>
				<ul class="skill-list">
					<li class="skill-item">
						<span>Atmel / Microchip Studio</span><div
							class="skill-logos"
						>
							<Image
								src={atmelIcon}
								alt="Atmel"
								width={22}
								height={22}
								quality={100}
								class="logo-dark"
							/>
						</div>
					</li>
					<li class="skill-item">
						<span>Arduino</span><div class="skill-logos">
							<Image
								src={arduinoIcon}
								alt="Arduino"
								width={22}
								height={22}
								quality={100}
							/>
						</div>
					</li>
					<li class="skill-item">
						<span>Fritzing</span><div class="skill-logos">
							<Image
								src={fritzingIcon}
								alt="Fritzing"
								width={22}
								height={22}
								quality={100}
								class="logo-dark"
							/>
						</div>
					</li>
				</ul>
			</div>

			<div class="skills-group">
				<h3 class="p">Tools</h3>
				<ul class="skill-list">
					<li class="skill-item">
						<span>Git</span><div class="skill-logos">
							<Image
								src={gitIcon}
								alt="Git"
								width={22}
								height={22}
								quality={100}
							/>
						</div>
					</li>
					<li class="skill-item">
						<span>Bash</span><div class="skill-logos">
							<Image
								src={bashIcon}
								alt="Bash"
								width={22}
								height={22}
								quality={100}
							/>
						</div>
					</li>
					<li class="skill-item">
						<span>Docker</span><div class="skill-logos">
							<Image
								src={dockerIcon}
								alt="Docker"
								width={22}
								height={22}
								quality={100}
							/>
						</div>
					</li>
				</ul>
			</div>
		</div>
	</section>

	<section class="personality-section">
		<h2>Persönlichkeit & Werte</h2>
		<div class="personality-grids">
			<div class="traits">
				<h3 class="p">Werte</h3>
				<div class="traits-grid">
					<div class="trait-card">
						<div class="trait-icon">
							<Image
								loading="eager"
								src={sproutIcon}
								alt="Sprout"
								width={30}
								height={30}
								quality={100}
							/>
						</div>
						<h4>Bodenständig</h4>
						<p>
							Kein Hype, kein Overengineering. Alles solide und
							wartbar.
						</p>
					</div>
					<div class="trait-card">
						<div class="trait-icon">
							<Image
								loading="eager"
								src={brainIcon}
								alt="Brain"
								width={30}
								height={30}
								quality={100}
							/>
						</div>
						<h4>Neugierig</h4>
						<p>
							Wenn ich etwas nicht verstehe, finde ich heraus, wie
							es funktioniert.
						</p>
					</div>
					<div class="trait-card">
						<div class="trait-icon">
							<Image
								loading="eager"
								src={stoneIcon}
								alt="Stone"
								width={30}
								height={30}
								quality={100}
							/>
						</div>
						<h4>Ruhig & Gelassen</h4>
						<p>Sorgfältiges Arbeiten spart Zeit und Nerven.</p>
					</div>
					<div class="trait-card">
						<div class="trait-icon">
							<Image
								loading="eager"
								src={shieldIcon}
								alt="Shield"
								width={30}
								height={30}
								quality={100}
							/>
						</div>
						<h4>Ehrlich</h4>
						<p>
							Eine zuverlässige Antwort, ist mehr wert als viele
							Worte.
						</p>
					</div>
				</div>
			</div>
			<div class="interests">
				<h3 class="p">Interessen</h3>
				<div class="interests-grid">
					<div class="trait-card">
						<div class="trait-icon">
							<Image
								src={leafIcon}
								alt="Natur"
								width={22}
								height={22}
								quality={100}
							/>
						</div>
						<div class="interest-text">
							<h4 class="interest-title">
								Gärtnern & Landwirtschaft
							</h4>
							<p class="interest-copy">
								Als Ausgleich zur digitalen Welt verbringe ich
								gerne Zeit im Garten und auf dem Bauernhof.
							</p>
						</div>
					</div>
					<div class="trait-card">
						<div class="trait-icon">
							<Image
								src={guitarIcon}
								alt="Gitarre"
								width={22}
								height={22}
								quality={100}
							/>
						</div>
						<div class="interest-text">
							<h4 class="interest-title">Gitarre</h4>
							<p class="interest-copy">
								Gerne spiele ich Gitarre alleine aber auch
								zusammen mit einem Freund.
							</p>
						</div>
					</div>
					<div class="trait-card">
						<div class="trait-icon">
							<Image
								src={gamepadIcon}
								alt="Spiele"
								width={22}
								height={22}
								quality={100}
							/>
						</div>
						<div class="interest-text">
							<h4 class="interest-title">Videospiele</h4>
							<p class="interest-copy">
								In meiner Freizeit spiele ich am liebsten
								Rätsel-Videospiele, treffe mich aber auch gerne
								für andere Games mit Freunden.
							</p>
						</div>
					</div>
					<div class="trait-card">
						<div class="trait-icon">
							<Image
								src={bookTextIcon}
								alt="Neues Lernen"
								width={22}
								height={22}
								quality={100}
							/>
						</div>
						<div class="interest-text">
							<h4 class="interest-title">Lesen</h4>
							<p class="interest-copy">
								Ich lese gerne Englische novels und Bücher zur
								Persönlichkeitsentwicklung.
							</p>
						</div>
					</div>
					<div class="trait-card">
						<div class="trait-icon">
							<Image
								src={settingsIcon}
								alt="Basteln"
								width={22}
								height={22}
								quality={100}
							/>
						</div>
						<div class="interest-text">
							<h4 class="interest-title">Basteln & Hardware</h4>
							<p class="interest-copy">
								Zuhause und auf dem Hof bin ich gerne
								handwerklich aktiv ob Holzarbeiten oder
								Schweißen an Landmaschinen.
							</p>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>
</BaseLayout>

<script>
	const slides = Array.from(document.querySelectorAll(".project-slide"));
	const prevButton = document.querySelector(".project-prev");
	const nextButton = document.querySelector(".project-next");
	let activeIndex = 0;

	function updateSlider(newIndex: number) {
		activeIndex = (newIndex + slides.length) % slides.length;

		slides.forEach((slide, index) => {
			const isActive = index === activeIndex;
			slide.classList.toggle("is-active", isActive);
			slide.setAttribute("aria-hidden", String(!isActive));
		});
	}

	prevButton?.addEventListener("click", () => updateSlider(activeIndex - 1));
	nextButton?.addEventListener("click", () => updateSlider(activeIndex + 1));
</script>
