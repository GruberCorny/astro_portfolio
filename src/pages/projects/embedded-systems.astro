---
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/projects.css";

import cIcon from "../../../assets/logos/c-svgrepo-com.svg";
import asmIcon from "../../../assets/logos/asm-icon.svg";
import arduinoIcon from "../../../assets/logos/arduino-svgrepo-com.svg";
import fritzingIcon from "../../../assets/logos/fritzing.svg";
import atmelIcon from "../../../assets/logos/AtmelStudio-Logos/AtmelStudio-Bug-White-With-BG.svg";
import vscodeIcon from "../../../assets/logos/vs-code-svgrepo-com.svg";
import emKastenImage from "../../../assets/EM/emkasten.jpg";
import ketenRoboTopImage from "../../../assets/EM/ketenrobooben.jpg";
import atmelStudioImage from "../../../assets/EM/atmelstudiovoll.png";
import ketenRoboImage from "../../../assets/EM/Ketenrobo.jpg";
---

<BaseLayout title="Embedded Systems – Corny Gruber">
    <div class="project-page">
        <div class="project-header">
            <h1>Embedded Systems</h1>
            <div class="project-tools" aria-label="Verwendete Werkzeuge">
                <span class="tool-badge"
                    ><Image src={cIcon} alt="C" width={24} height={24} /></span
                >
                <span class="tool-badge"
                    ><Image
                        src={asmIcon}
                        alt="Assembly"
                        width={24}
                        height={24}
                    /></span
                >
                <span class="tool-badge"
                    ><Image
                        src={arduinoIcon}
                        alt="Arduino"
                        width={24}
                        height={24}
                    /></span
                >
                <span class="tool-badge"
                    ><Image
                        src={fritzingIcon}
                        alt="Fritzing"
                        width={24}
                        height={24}
                    /></span
                >
                <span class="tool-badge"
                    ><Image
                        src={atmelIcon}
                        alt="Atmel Studio"
                        width={24}
                        height={24}
                    /></span
                >
                <span class="tool-badge"
                    ><Image
                        src={vscodeIcon}
                        alt="VS Code"
                        width={24}
                        height={24}
                    /></span
                >
            </div>
            <p class="project-description">
                Hier zeige ich einzelne Skills, praktische Erfahrungen und
                Umsetzungen aus dem Bereich Embedded Systems, mit Fokus auf
                Hardware, Software und Sensorik.
            </p>
        </div>

        <section class="project-entry project-entry--image-left">
            <div class="project-entry-media">
                <Image
                    loading="eager"
                    src={emKastenImage}
                    alt="Embedded-System Aufbau im Kasten"
                    quality={90}
                    sizes="(max-width: 720px) 100vw, 680px"
                />
            </div>
            <div class="project-entry-content">
                <h4>Steckbrett-Aufbau</h4>
                <p>
                    Ich habe Erfahrung im Aufbau von Steckbrettern und Schaltungen wie diese verkabelt und gelötet werden und was dabei zu beachten ist.
                </p>
            </div>
        </section>

        <section class="project-entry project-entry--image-right">
            <div class="project-entry-media">
                <Image
                    src={atmelStudioImage}
                    alt="Code und Projektstruktur in Atmel Studio"
                    quality={90}
                    sizes="(max-width: 720px) 100vw, 680px"
                />
            </div>
            <div class="project-entry-content">
                <h4>Entwicklung in Atmel Studio</h4>
                <p>
                    Das Code simulieren und auf den Microcontroller laden ist ein zentraler Bestandteil hierbei habe ich sowohl durch das Putty-Terminal mit dem Microcontroller kommuniziert als auch grundlegenden Konfigurationen an dem Microcontroller vorgenommen, wie das Setzen von Fuses, Erstellen eines Bootloaders und Umsetzung von Sicherheitsstanddarts durchgeführt.
                </p>
            </div>
        </section>

        <section class="project-entry project-entry--image-left">
            <div class="project-entry-media">
                <Image
                    src={ketenRoboTopImage}
                    alt="Sensoren und Verkabelung am Aufbau"
                    quality={90}
                    sizes="(max-width: 720px) 100vw, 680px"
                />
            </div>
            <div class="project-entry-content">
                <h4>Sensoren und Schnittstellen</h4>
                <p>
                    Ich habe Erfahrung im Umgang mit verschiedenen Sensoren wie Lidar, Ultraschallsensoren, Infrarotsensoren und deren Schnittstellen gesammelt, einschließlich der Verkabelung und der Auswertung der Sensordaten.
                </p>
            </div>
        </section>

        <section class="project-entry project-entry--image-right">
            <div class="project-entry-media">
                <Image
                    src={ketenRoboImage}
                    alt="Selbstgebauter Kettenroboter"
                    quality={90}
                    sizes="(max-width: 720px) 100vw, 680px"
                />
            </div>
            <div class="project-entry-content">
                <h4>Selbstgebaute Roboter</h4>
                <p>
                    Auch daheim baue ich an Eigenen Projekten wie diesem Kettenroboter, in denen ich meine Kenntnisse in Mechanik, Elektronik und Programmierung praktisch anwende.
                </p>
            </div>
        </section>
    </div>
</BaseLayout>
