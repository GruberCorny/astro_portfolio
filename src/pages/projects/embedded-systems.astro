---
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/projects.css";

import cIcon from "../../../assets/logos/c-svgrepo-com.svg";
import asmIcon from "../../../assets/logos/asm-icon.svg";
import arduinoIcon from "../../../assets/logos/arduino-svgrepo-com.svg";
import fritzingIcon from "../../../assets/logos/fritzing.svg";
import atmelIcon from "../../../assets/logos/AtmelStudio-Logos/AtmelStudio-Bug-White-With-BG.svg";
import vscodeIcon from "../../../assets/logos/vs-code-svgrepo-com.svg";
import emKastenImage from "../../../assets/EM/emkasten.jpg";
import ketenRoboTopImage from "../../../assets/EM/ketenrobooben.jpg";
import atmelStudioImage from "../../../assets/EM/atmelstudiovoll.png";
import resultImage from "../../../assets/EM/IMG_20261031_162639778.jpg";
---

<BaseLayout title="Embedded Systems – Corny Gruber">
    <div class="project-page">
        <div class="project-header">
            <h1>Embedded Systems</h1>
            <div class="project-tools" aria-label="Verwendete Werkzeuge">
                <span class="tool-badge"
                    ><Image src={cIcon} alt="C" width={24} height={24} /></span
                >
                <span class="tool-badge"
                    ><Image
                        src={asmIcon}
                        alt="Assembly"
                        width={24}
                        height={24}
                    /></span
                >
                <span class="tool-badge"
                    ><Image
                        src={arduinoIcon}
                        alt="Arduino"
                        width={24}
                        height={24}
                    /></span
                >
                <span class="tool-badge"
                    ><Image
                        src={fritzingIcon}
                        alt="Fritzing"
                        width={24}
                        height={24}
                    /></span
                >
                <span class="tool-badge"
                    ><Image
                        src={atmelIcon}
                        alt="Atmel Studio"
                        width={24}
                        height={24}
                    /></span
                >
                <span class="tool-badge"
                    ><Image
                        src={vscodeIcon}
                        alt="VS Code"
                        width={24}
                        height={24}
                    /></span
                >
            </div>
            <p class="project-description">
                Microcontroller, Low-Level-Programmierung und Hardware-nahe
                Software.
            </p>
        </div>

        <section class="project-entry project-entry--image-left">
            <div class="project-entry-media">
                <Image
                    loading="eager"
                    src={emKastenImage}
                    alt="Embedded-System Aufbau im Kasten"
                    quality={90}
                    sizes="(max-width: 720px) 100vw, 680px"
                />
            </div>
            <div class="project-entry-content">
                <h4>Aufbau auf dem Steckbrett</h4>
                <p>
                    Der erste Schritt war der komplette Grundaufbau auf dem
                    Steckbrett: Spannungsversorgung, Verkabelung und saubere
                    Struktur der einzelnen Verbindungen. Dabei war mir wichtig,
                    dass das Setup leicht testbar bleibt und ich Komponenten
                    schnell erweitern oder austauschen kann.
                </p>
            </div>
        </section>

        <section class="project-entry project-entry--image-right">
            <div class="project-entry-media">
                <Image
                    src={atmelStudioImage}
                    alt="Code und Projektstruktur in Atmel Studio"
                    quality={90}
                    sizes="(max-width: 720px) 100vw, 680px"
                />
            </div>
            <div class="project-entry-content">
                <h4>Entwicklung in Atmel Studio</h4>
                <p>
                    In Atmel Studio habe ich das Projekt strukturiert aufgebaut,
                    die Controller-Logik umgesetzt und die einzelnen Module
                    Schritt für Schritt getestet. So konnte ich Fehler gezielt
                    eingrenzen und die Funktionen sauber aufeinander abstimmen.
                </p>
            </div>
        </section>

        <section class="project-entry project-entry--image-left">
            <div class="project-entry-media">
                <Image
                    src={ketenRoboTopImage}
                    alt="Sensoren und Verkabelung am Aufbau"
                    quality={90}
                    sizes="(max-width: 720px) 100vw, 680px"
                />
            </div>
            <div class="project-entry-content">
                <h4>Sensoren und Auswertung</h4>
                <p>
                    Die Sensoren liefern die wichtigen Eingangsdaten für das
                    Verhalten des Systems. Ich habe die Messwerte eingelesen,
                    gefiltert und in klare Reaktionen übersetzt, damit der
                    Aufbau zuverlässig und reproduzierbar arbeitet.
                </p>
            </div>
        </section>

        <section class="project-entry project-entry--image-right">
            <div class="project-entry-media">
                <Image
                    src={resultImage}
                    alt="Fertiges Embedded-System Ergebnis"
                    quality={90}
                    sizes="(max-width: 720px) 100vw, 680px"
                />
            </div>
            <div class="project-entry-content">
                <h4>Selbstgebauter Roboter</h4>
                <p>
                    Am Ende ist ein selbstgebauter Roboter entstanden, bei dem
                    Hardware und Software sauber zusammenspielen. Besonders
                    wertvoll war für mich der komplette Weg vom Steckbrett-
                    Prototyp bis zur funktionierenden, eigenständigen Lösung.
                </p>
            </div>
        </section>
    </div>
</BaseLayout>
