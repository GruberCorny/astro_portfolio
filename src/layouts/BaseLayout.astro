---
import Navbar from "../components/Navbar.astro";
import SiteFooter from "../components/SiteFooter.astro";
import "../styles/global.css";
import faviconImage from "../../assets/profile-favicon-square.jpg";
---

<html lang="de">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/jpeg" href={faviconImage.src} />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="generator" content={Astro.generator} />
        <meta property="og:title" content="Cornelius Gruber Portfolio" />
        <meta property="og:description" content="Cornelius Gruber Portfolio" />
        <meta property="og:image" content={faviconImage.src} />
    </head><body id="top">
        <Navbar />
        <main>
            <slot />
        </main>
        <SiteFooter />
    </body>
</html>
