---
import Navbar from "../components/Navbar.astro";
import SiteFooter from "../components/SiteFooter.astro";
import "../styles/global.css";
import ogImage from "../../assets/profile-favicon-square.jpg";
---

<html lang="de">
    <head>
        <script is:inline>
            const savedTheme = localStorage.getItem("theme");
            if (savedTheme === "dark" || savedTheme === "light") {
                document.documentElement.setAttribute("data-theme", savedTheme);
            }
        </script>

        <meta charset="utf-8" />
        <link rel="icon" href="/favicon.ico?v=3" sizes="any" />
        <link
            rel="icon"
            type="image/png"
            href="/favicon-32x32.png?v=3"
            sizes="32x32"
        />
        <link
            rel="icon"
            type="image/png"
            href="/favicon-16x16.png?v=3"
            sizes="16x16"
        />
        <link
            rel="apple-touch-icon"
            href="/apple-touch-icon.png?v=3"
            sizes="180x180"
        />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="generator" content={Astro.generator} />
        <meta property="og:title" content="Cornelius Gruber Portfolio" />
        <meta property="og:description" content="Cornelius Gruber Portfolio" />
        <meta property="og:image" content={ogImage.src} />
        <title>Cornelius Gruber Portfolio</title>
        <meta
            name="description"
            content="a portfolio by Cornelius Gruber showcasing projects and skills of Cornelius Gruber"
        />
    </head><body id="top">
        <Navbar />
        <main>
            <slot />
        </main>
        <SiteFooter />
    </body>
</html>
