---
import { Image, type ImageMetadata } from "astro:assets";

interface Props {
    tag?: string;
    title: string;
    text: string;
    imageSrc?: ImageMetadata;
    imageAlt?: string;
    imageLeft?: boolean;
    portrait?: boolean;
}

const {
    tag,
    title,
    text,
    imageSrc,
    imageAlt = "",
    imageLeft = true,
    portrait = false,
} = Astro.props;

const imageDimensions = portrait
    ? { width: 480, height: 640 }
    : { width: 640, height: 420 };
---

<div
    class:list={[
        "project-entry",
        imageLeft ? "image-left" : "image-right",
        portrait && "portrait",
    ]}
>
    <div class="project-entry-image">
        {
            imageSrc ? (
                <Image
                    src={imageSrc}
                    alt={imageAlt}
                    width={imageDimensions.width}
                    height={imageDimensions.height}
                    quality={portrait ? 82 : 78}
                />
            ) : (
                <div class="project-entry-placeholder" aria-hidden="true" />
            )
        }
    </div>
    <div class="project-entry-text">
        {tag && <p class="section-label">{tag}</p>}
        <h3>{title}</h3>
        <p>{text}</p>
    </div>
</div>
