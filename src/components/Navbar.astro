---
import "../styles/navbar.css";
---

<header>
    <nav class="navbar">
        <ul class="nav-links">
            <li><a href="/">Home</a></li>
            <li><a href="/about">About Me</a></li>
            <li class="dropdown">
                <button
                    class="dropdown-toggle"
                    aria-haspopup="true"
                    aria-expanded="false"
                >
                    Projects <span class="arrow">▾</span>
                </button>
                <ul class="dropdown-menu">
                    <li>
                        <a
                            aria-label="App-Entwicklung"
                            href="/projects/app-entwicklung">App-Entwicklung</a
                        >
                    </li>
                    <!-- Embedded Systems 
                    <li>
                        <a
                            aria-label="Embedded Systems"
                            href="/projects/embedded-systems"
                            >Embedded Systems</a
                        >
                    </li>
                    -->
                    <li>
                        <a aria-label="Bitburner" href="/projects/bitburner"
                            >Bitburner</a
                        >
                    </li>
                    <li>
                        <a aria-label="RevXT" href="/projects/revxt">RevXT</a>
                    </li>
                </ul>
            </li>
        </ul>

        <div class="nav-icons">
            <a
                href="https://github.com/GruberCorny"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="GitHub"
            >
                <!-- GitHub Icon -->
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="22"
                    height="22"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                >
                    <path
                        d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.385-1.335-1.755-1.335-1.755-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
                    ></path>
                </svg>
            </a>
            <a href="mailto:co.postfach@gmail.com" aria-label="E-Mail">
                <!-- Mail Icon -->
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="22"
                    height="22"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                >
                    <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                    <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
                </svg>
            </a>
            <button id="theme-toggle" aria-label="Theme umschalten">
                <!-- Sun Icon (light mode) -->
                <svg
                    id="icon-sun"
                    xmlns="http://www.w3.org/2000/svg"
                    width="22"
                    height="22"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                >
                    <circle cx="12" cy="12" r="4"></circle>
                    <path
                        d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"
                    ></path>
                </svg>
                <!-- Moon Icon (dark mode) -->
                <svg
                    id="icon-moon"
                    xmlns="http://www.w3.org/2000/svg"
                    width="22"
                    height="22"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                >
                    <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
                </svg>
            </button>
        </div>

        <!-- Mobile hamburger -->
        <button
            id="mobile-menu-toggle"
            aria-label="Menü öffnen"
            aria-expanded="false"
        >
            <span></span><span></span><span></span>
        </button>
    </nav>
</header>
<!-- Mobile nav drawer -->
<div id="mobile-nav" aria-hidden="true">
    <ul>
        <li><a href="/">Home</a></li>
        <li><a href="/about">About Me</a></li>
        <li>
            <button class="mobile-submenu-toggle" aria-expanded="false">
                Projects <span class="arrow">▾</span>
            </button>
            <ul class="mobile-submenu">
                <li><a href="/projects/app-entwicklung">App-Entwicklung</a></li>
                <li>
                    <a href="/projects/embedded-systems">Embedded Systems</a>
                </li>
                <li><a href="/projects/bitburner">Bitburner</a></li>
                <li><a href="/projects/revxt">RevXT</a></li>
            </ul>
        </li>
    </ul>
</div>

<script>
    import "../scripts/dropdown.ts";
    import "../scripts/mobile-menu.ts";
    import "../scripts/theme.ts";
</script>
